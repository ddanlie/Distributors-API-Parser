# Draft for a Service
# Place to /etc/systemd/system/myapi.service


[Unit]
Description=My FastAPI app
After=network.target

[Service]
User=youruser
WorkingDirectory=/path/to/app
ExecStart=/path/to/.venv/bin/gunicorn parser.main:app \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000
Restart=always

[Install]
WantedBy=multi-user.target
